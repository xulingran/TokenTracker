# InsForge：OAuth SDK 与排行榜 Edge（Leaderboard 用 getLeaderboardBaseUrl；仪表盘在 localhost 仍走相对路径 CLI API）。
VITE_INSFORGE_BASE_URL=https://your-project.us-east.insforge.app
VITE_INSFORGE_ANON_KEY=

# 仅在可信局域网使用私有 IP 的 HTTP 后端时设为 1；需要重新构建 Dashboard。
# 不会允许公网 HTTP，也不会接受 nas.local 等主机名。
VITE_TOKENTRACKER_ALLOW_PRIVATE_HTTP=0

# 可选：固定单用户自托管部署的登录邮箱。设置后登录页只显示密码输入，
# 并隐藏邮箱、OAuth、注册和忘记密码入口。不要在前端环境中配置任何密码。
VITE_TOKENTRACKER_DEFAULT_LOGIN_EMAIL=

# 设为 1 时仪表盘/排行榜用本地假数据；真实排行榜需关闭 mock。
# VITE_TOKENTRACKER_MOCK=0

